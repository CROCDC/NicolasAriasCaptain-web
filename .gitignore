.env.production

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# What a failed visual comparison leaves behind for a human to look at; the
# committed baseline it differs from is the file worth keeping.
tests/screenshots/**/*.actual.png
tests/screenshots/**/*.diff.png

# Unit test / coverage reports
.tox/
.coverage
.coverage.*
.cache
htmlcov/
.pytest_cache/
coverage.xml
*.cover

# MyPy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

